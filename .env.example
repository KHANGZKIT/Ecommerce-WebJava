# ============================================================
# Observable Microservices E-Commerce — Environment Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Update with your real credentials for local development.
# 3. NEVER commit the real '.env' file to Git or push to GitHub.
# ============================================================

# --- PostgreSQL (shared across all *-db containers) -----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# --- JWT (used by user-service, cart-service, api-gateway) ----
# Must be at least 256-bit (32+ bytes) random secret for HMAC-SHA256
# Example generation: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_random_string_here

# --- Frontend & Gateway API Config ----------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- MoMo Payment Gateway (Sandbox v3 API) --------------------
